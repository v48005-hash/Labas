<% if (status === 'passed') { %><span class="chip chip-green">Išlaikyta</span>
<% } else if (status === 'failed') { %><span class="chip chip-red">Neišlaikyta</span>
<% } else if (status === 'in_progress') { %><span class="chip chip-blue">Pradėta</span>
<% } else { %><span class="chip chip-gray">Priskirta</span><% } %>
